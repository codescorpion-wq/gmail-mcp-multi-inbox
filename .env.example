# Google OAuth client (from Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxx
# Only used by auth/get-refresh-token.js during the one-time setup
GOOGLE_REDIRECT_URI=http://localhost:53682/oauth2callback

# Produced by `npm run get-token`. Extra inboxes: `npm run get-token -- work` -> GMAIL_REFRESH_TOKEN_WORK etc. Never commit.
GMAIL_REFRESH_TOKEN=xxxxxxxx

# The Gmail address this server acts as 
GMAIL_ACCOUNT_EMAIL=you@example.com

# Hosted options (B and C) only: the password in your connector URL.
# Generate one with: openssl rand -hex 32. Not needed for local Claude Desktop / Claude Code use.
MCP_SHARED_SECRET=xxxxxxxx

# Port for the standalone server (Option B). Most hosts set this for you; Vercel ignores it.
PORT=3000

# Optional: let /api/connect add inboxes from any domain (default: same domain as GMAIL_ACCOUNT_EMAIL)
# ALLOW_ANY_GMAIL=true
